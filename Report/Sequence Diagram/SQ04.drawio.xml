ILL s           ON s.SkillID     = es.SkillID&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHERE e.Role = &#39;TechEngineer&#39;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;GROUP BY e.EmployeeID, e.FirstName, e.LastName;">
